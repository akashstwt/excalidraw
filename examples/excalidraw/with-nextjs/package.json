{
  "name": "with-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:workspace": "node init && yarn workspace @excalidraw/excalidraw run build:esm && yarn copy:assets",
    "copy:assets": "cp ../../../packages/excalidraw/dist/browser/prod/excalidraw-assets/*.woff2 ./public",
    "dev": "node init && yarn build:workspace && next dev -p 3005",
    "build": "node init && yarn build:workspace && next build",
    "start": "node init && next start -p 3006",
    "lint": "next lint"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "*",
    "next": "14.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "path2d-polyfill": "2.0.1",
    "typescript": "^5"
  }
}
